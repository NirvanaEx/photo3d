# Веса моделей — 20-30 ГБ, качаются скриптом
data/weights/*
!data/weights/.gitkeep

# Рабочие данные
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep
data/cache/*
!data/cache/.gitkeep
# Корзина: удалённые модели ждут здесь возврата. Растёт так же, как output,
# и по тем же причинам в репозитории ей делать нечего.
data/trash/
# Очередь заданий: состояние здешней машины на здешний момент. Замок воркера
# и вовсе содержит pid живого процесса - в репозитории от него один вред.
data/jobs/
# Фотосканные материалы: качаются scripts/fetch_textures.py с Poly Haven,
# весят десятки мегабайт на набор. В репозитории им делать нечего по той же
# причине, что и весам моделей - воспроизводятся одной командой.
data/textures/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Окружение
.env

# Артефакты 3D
*.glb
*.gltf
*.usdz
*.obj
*.stl
*.ply
*.blend1

# Godot
# Кэш импорта: пересобирается из ассетов мостом и весит примерно столько же,
# сколько они сами (63 МБ ассетов дали 57 МБ кэша).
game/.godot/
# Ассеты приезжают из data/output через bridge/import_asset.py, поэтому папка
# игнорируется целиком, а не по расширениям: кроме GLB импортёр кладёт сюда же
# распакованные текстуры (встроенные в GLB картинки он вытаскивает отдельными
# PNG - у коридора их десять) и файлы настроек импорта. Всё это производное.
# Что из какой модели собрано - в game/assets.json, он в репозитории.
game/assets/models/*
!game/assets/models/.gitkeep

# ОС и редакторы
.DS_Store
Thumbs.db
.vscode/
.idea/
