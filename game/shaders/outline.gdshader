shader_type spatial;
// Обводка предмета: раздутая копия его же геометрии, у которой видны только
// изнаночные грани. Приём старый и до сих пор самый дешёвый - ни второго
// прохода по экрану, ни чтения глубины.
//
// cull_front, а не cull_back: наружу смотрит изнанка раздутой оболочки, и
// именно она образует кайму вокруг силуэта. При обычном отсечении копия
// просто накрыла бы предмет целиком.
//
// depth_draw_never - чтобы кайма не оставляла себя в буфере глубины и не
// срезала то, что стоит за предметом.
//
// unshaded - кайма не должна темнеть в тени: она подсказка интерфейса, а не
// часть мира, и в тёмном углу нужна ровно так же, как на свету.
render_mode unshaded, cull_front, depth_draw_never, blend_mix;

// Толщина в МЕТРАХ, а не в пикселях. У модели величиной с бюст и у стены
// одинаковая кайма в пикселях требовала бы деления на расстояние; здесь же
// предметы осматриваются с полутора метров, и постоянная толщина честнее.
uniform float width : hint_range(0.0, 0.2) = 0.012;
uniform vec4 color : source_color = vec4(1.0, 0.86, 0.55, 1.0);

void vertex() {
	// По нормали, а не масштабированием от центра: масштаб раздувает
	// длинную парту вдоль неё же, и с торцов кайма выходит втрое толще.
	VERTEX += normalize(NORMAL) * width;
}

void fragment() {
	ALBEDO = color.rgb;
	ALPHA = color.a;
}
