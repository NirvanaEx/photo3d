shader_type spatial;
// Каркас по габаритам зоны осмотра.
//
// Нужен потому, что обводить у зоны нечего: локация приезжает одним GLB, и
// отдельного меша у парты внутри него нет (см. scripts/interactable.gd).
// Зона - это объём, а не поверхность, и единственное, что можно показать
// честно, - её границы.
//
// Рисуется каймой по краю каждой грани куба: у BoxMesh развёртка каждой грани
// идёт от 0 до 1, поэтому близость к краю считается прямо по UV. Заливка
// внутри прозрачна - предмет должен остаться видимым, рамка лишь очерчивает.
// blend_mix, а НЕ blend_add. С аддитивным смешением рамка складывается с
// картинкой и в тёмной комнате превращается в неоновую трубку: замер на
// закатном классе показал светящуюся балку через всю сцену вместо тонкой
// подсказки. Подсветка не источник света, она метка поверх изображения.
render_mode unshaded, cull_disabled, depth_draw_never, blend_mix;

uniform float thickness : hint_range(0.001, 0.2) = 0.022;
// Приглушённый тёплый: на закатной сцене чистый белый выглядит инородно,
// а полная непрозрачность перекрывает то, что обводит.
uniform vec4 color : source_color = vec4(1.0, 0.88, 0.62, 0.62);
uniform float pulse_speed = 2.2;

void fragment() {
	// Расстояние до ближайшего края грани в единицах развёртки.
	vec2 d = min(UV, vec2(1.0) - UV);
	float edge = min(d.x, d.y);
	// smoothstep, а не сравнение: жёсткая граница на наклонных гранях
	// рассыпается в лесенку, особенно на дальней парте.
	float line = 1.0 - smoothstep(thickness * 0.5, thickness, edge);
	if (line < 0.01) {
		discard;
	}
	// Медленное дыхание: неподвижная рамка на статичной сцене читается как
	// часть декорации, а не как отклик на взгляд.
	float pulse = 0.82 + 0.18 * sin(TIME * pulse_speed);
	ALBEDO = color.rgb;
	// Прозрачность несёт и линию, и дыхание. Раньше то же самое делалось
	// через ALBEDO, и на аддитивном смешении рамка жгла картинку насквозь.
	ALPHA = color.a * line * pulse;
}
