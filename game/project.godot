; Проект-мир: сюда приезжают ассеты из data/output, здесь собираются сцены.
; Правится текстом - и сценами, и этим файлом. Редактор для работы не нужен.
;
; Запуск с Windows-стороны (см. server/config.py: GODOT), потому что из WSL
; движок получил бы программный графический контекст вместо RTX 3060.

config_version=5

[application]

config/name="photo3d"
config/description="Мир, собранный из ассетов photo3d"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

anti_aliasing/quality/msaa_3d=2
