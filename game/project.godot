; Проект-мир: сюда приезжают ассеты из data/output, здесь собираются сцены.
; Правится текстом - и сценами, и этим файлом. Редактор для работы не нужен.
;
; Запуск с Windows-стороны (см. server/config.py: GODOT), потому что из WSL
; движок получил бы программный графический контекст вместо RTX 3060.

config_version=5

[application]

config/name="photo3d"
config/description="Мир, собранный из ассетов photo3d"
run/main_scene="res://scenes/launcher.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

anti_aliasing/quality/msaa_3d=2
; Карта теней на весь архипелаг: 260 м на 4096 точек это 6 см на точку, и
; тень от дерева получалась ступенчатой лесенкой. 8192 стоит 128 МБ видеопамяти
; из 10.7 доступных - терпимо, а край тени становится краем, а не пилой.
lights_and_shadows/directional_shadow/size=8192
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
environment/ssao/quality=3
environment/ssil/quality=2
textures/default_filters/anisotropic_filtering_level=3
