; Класс на закате - ходьба. Собран из game-ready ассета m_classroom_game:
; столкновения внутри ассета (-colonly), в сцене их узлов нет.
;
; Свет сведён под референс data/input/ref_classroom.jpg: низкое оранжевое
; солнце из окон (стена -X), тёплый рассеянный, глянец паркета через SSR.
; Направление солнца НЕ на глаз: вектор из classroom.py (солнце_летит
; [0.872, 0.464, -0.156] в осях Blender) переведён в оси Godot (x, z, -y) ->
; (0.872, -0.156, -0.464), базис ниже собран так, что его -Z равен этому
; вектору. Матрица в .tscn пишется СТРОКАМИ (docs/PITFALLS.md).

[gd_scene load_steps=13 format=3]

[ext_resource type="PackedScene" path="res://assets/models/m_classroom_game.glb" id="1_location"]
[ext_resource type="Script" path="res://scripts/player.gd" id="3_player"]
[ext_resource type="Script" path="res://scripts/location.gd" id="4_location_fix"]
[ext_resource type="Script" path="res://scripts/room_audio.gd" id="5_audio"]
[ext_resource type="Script" path="res://scripts/interactable.gd" id="6_look"]

[sub_resource type="Environment" id="Environment_classroom"]
background_mode = 1
background_color = Color(0.035, 0.022, 0.018, 1)
; Рассеянный свет тёплый и слабый: закатная комната живёт контрастом между
; оранжевыми пятнами солнца и тёплым полумраком. Холодного здесь нет вовсе -
; в отличие от коридора, где тень принципиально синяя.
ambient_light_source = 2
ambient_light_color = Color(0.66, 0.49, 0.37, 1)
; Было 0.9. Ручной рассеянный - заплатка вместо отражений: он одинаково светит
; и в угол, и на открытое место. Отражённый свет теперь считает SDFGI ниже, и
; прежние 0.9 просто затопили бы его ровной заливкой. В ноль не убираем:
; SDFGI сходится не мгновенно, и первые кадры после входа были бы чёрными.
ambient_light_energy = 0.72
; Глобальное освещение в реальном времени: свет от закатных пятен на полу
; уходит на потолок и в тень под партами. Ровно этого на кадре до включения и
; не было - потолок освещён равномерно, будто пола под ним нет.
sdfgi_enabled = true
; Доля света, уходящая на следующий отскок. Больше - теплее и наполненнее, но
; в замкнутой комнате растёт риск разгона яркости.
sdfgi_bounce_feedback = 0.5
sdfgi_use_occlusion = true
; Ячейка под размер класса: 9 на 7 метров укладываются в первые каскады,
; мельчить незачем - это прямая цена по кадрам.
sdfgi_min_cell_size = 0.1
sdfgi_cascades = 4
; 3.2, а не единица. Замер: со значением 1.1 класс выходил заметно темнее
; прежнего, и правая половина уходила в черноту. Причина не в настройке GI, а
; в том, что SDFGI ЗАМЕНЯЕТ собой ручной рассеянный свет: прежние
; ambient_light_energy = 0.9 были художественной подсветкой, физически ничем
; не обеспеченной, а отскоков от одного закатного окна честно мало.
; Энергия — то место, где эта разница возвращается обратно.
sdfgi_energy = 3.2
tonemap_exposure = 1.15
; AgX: тот же тонмаппер, что в Cycles-рендере локации, - иначе сведение
; по референсу пришлось бы делать дважды, под два разных отклика.
tonemap_mode = 4
; Отражения экранного пространства - блики окон в лакированном паркете.
; Референс держится на них: пол там зеркалит закат.
ssr_enabled = true
ssr_max_steps = 48
ssao_enabled = true
ssil_enabled = true
glow_enabled = true
glow_intensity = 0.6
glow_bloom = 0.14
; Порог выше единицы: под ним белые корпуса выключенных светильников
; зацветали в мыльные пятна на потолке.
glow_hdr_threshold = 1.05
volumetric_fog_enabled = true
volumetric_fog_density = 0.012
volumetric_fog_albedo = Color(0.92, 0.74, 0.55, 1)
volumetric_fog_gi_inject = 0.0
volumetric_fog_length = 30.0
adjustment_enabled = true
adjustment_contrast = 1.06
adjustment_saturation = 1.12

[sub_resource type="ParticleProcessMaterial" id="Dust_proc"]
emission_shape = 3
emission_box_extents = Vector3(3.2, 1.3, 4.2)
direction = Vector3(0, -1, 0)
spread = 30.0
initial_velocity_min = 0.01
initial_velocity_max = 0.05
gravity = Vector3(0, -0.015, 0)
scale_min = 0.5
scale_max = 1.6
turbulence_enabled = true
turbulence_noise_strength = 0.12
turbulence_noise_scale = 1.6

[sub_resource type="StandardMaterial3D" id="Dust_mat"]
transparency = 1
albedo_color = Color(1, 0.9, 0.75, 0.55)
roughness = 1.0
billboard_mode = 3
billboard_keep_scale = true

[sub_resource type="QuadMesh" id="Dust_mesh"]
material = SubResource("Dust_mat")
size = Vector2(0.005, 0.005)

[sub_resource type="CapsuleShape3D" id="Capsule_player"]
radius = 0.32
height = 1.7

; Зоны осмотра. Координаты не на глаз: они пересчитаны из classroom.py по
; правилу этой сцены - Godot (x, y, z) = Blender (x, z, -y). Доска там стоит
; у стены y=9.0 шириной 3.6 со смещением -0.4; ряды парт - y 2.1…5.55,
; колонны - x -2.35…2.15; окна режутся в стене x=-3.7.
[sub_resource type="BoxShape3D" id="Box_board"]
size = Vector3(3.7, 1.3, 0.5)

[sub_resource type="BoxShape3D" id="Box_desk"]
size = Vector3(0.75, 0.9, 0.55)

[sub_resource type="BoxShape3D" id="Box_window"]
size = Vector3(0.5, 2.1, 2.0)

[node name="Classroom" type="Node3D"]

[node name="World" type="WorldEnvironment" parent="."]
environment = SubResource("Environment_classroom")

; Солнце у горизонта: почти оранжевое, длинные полосы через парты.
; Высота солнца - обратная задача от пятна: чтобы свет от верха окна (2.55 м)
; лёг на парты в середине комнаты (4.4 м от окон), нужно ~30 градусов.
; На 9 пятна прожигали правую стену, на 16 - плинтус. Вектор в осях Godot:
; (0.709, -0.5, -0.497), базис по строкам.
[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.574, 0.41, -0.709, 0, 0.866, 0.5, 0.819, -0.287, 0.497, -6, 2.5, -4)
light_energy = 6.5
light_color = Color(1, 0.62, 0.34, 1)
light_volumetric_fog_energy = 2.2
shadow_enabled = true

[node name="Location" parent="." instance=ExtResource("1_location")]
script = ExtResource("4_location_fix")

; Пыль в закатных лучах - освещаемая, вспыхивает только в свету.
[node name="Dust" type="GPUParticles3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.5, -4.5)
amount = 500
lifetime = 16.0
preprocess = 12.0
visibility_aabb = AABB(-4, -2, -9, 8, 4, 10)
process_material = SubResource("Dust_proc")
draw_pass_1 = SubResource("Dust_mesh")

; Появление у задней стены, лицом к доске (вперёд по -Z). Не под лампой:
; белый корпус светильника в полуметре над камерой занимал четверть кадра.
; Фон и реверб класса. Помещение среднее, пол лакированный - хвост короткий,
; но верх съедается мебелью и шторами (damping в скрипте).
[node name="Audio" type="Node" parent="."]
script = ExtResource("5_audio")
room_size = 0.5
; Было 0.14. Сухой короткий звук в помещении читается ударом, а не шагом:
; ухо опознаёт комнату по отражениям, и когда их нет, источник кажется
; приложенным к самому уху. Записи в наборе короткие (287 мс у дерева,
; 135 у плитки), поэтому доля отражённого здесь важнее обычного.
wet = 0.19

; В центральном проходе, а не в углу: прежняя точка (2.2, _, -0.5) попадала
; в колонну парт x=2.15 (classroom.py, COLS), и человек стартовал упёршись —
; замер прогулки давал 0.67 м пути и упор в препятствие с первого шага.
; Здесь между колоннами -0.85 и 0.65, перед первым рядом (тот на y=2.1).
[node name="Player" type="CharacterBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.1, 0.5, -0.9)
script = ExtResource("3_player")
; Паркет: шаг звонкий, с заметным хвостом (см. scripts/make_sounds.py).
footstep_surface = "wood"

[node name="Shape" type="CollisionShape3D" parent="Player"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.85, 0)
shape = SubResource("Capsule_player")

[node name="Camera" type="Camera3D" parent="Player"]
fov = 55.0

; --- что можно осмотреть ---
;
; Зоны, а не сами предметы: локация приезжает одним GLB, отдельных узлов у
; парты и доски внутри него нет (см. scripts/interactable.gd). Радиус reach
; у каждой свой - к доске подходят вплотную, ряд парт читается издали.

[node name="Look" type="Node3D" parent="."]

[node name="Board" type="Area3D" parent="Look"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -0.4, 1.5, -8.85)
script = ExtResource("6_look")
title = "Классная доска"
detail = "Зелёная, исписанная и стёртая столько раз, что мел въелся в поверхность дымкой. Внизу желобок с обломками и тряпка."
reach = 2.4

[node name="Shape" type="CollisionShape3D" parent="Look/Board"]
shape = SubResource("Box_board")

[node name="Window" type="Area3D" parent="Look"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, -3.45, 1.5, -3.75)
script = ExtResource("6_look")
title = "Окно во двор"
detail = "Раздвижные створки в алюминии, за ними закат и тёмная полоса деревьев. Солнце уже низко и кладёт через класс длинные полосы."
reach = 2.2

[node name="Shape" type="CollisionShape3D" parent="Look/Window"]
shape = SubResource("Box_window")

; Ближняя к игроку парта — та, до которой он дойдёт первой.
[node name="Desk" type="Area3D" parent="Look"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.15, 0.5, -2.1)
script = ExtResource("6_look")
title = "Парта"
detail = "Столешница 65 на 45, высота 73 сантиметра — стандарт, по которому их делают десятилетиями. Трубчатые ножки, крючок для портфеля сбоку."
reach = 1.6

[node name="Shape" type="CollisionShape3D" parent="Look/Desk"]
shape = SubResource("Box_desk")

; Зоны «задний ряд» здесь БЫЛА и убрана. Она накрывала все четыре парты
; сразу — 6.2 метра, — и подсветка такой зоны рисовала через класс светящуюся
; балку вместо метки предмета. Вывод общий: зона осмотра размером с комнату
; не читается как предмет, даже если по смыслу это один ряд.
;
; Учительский стол: отдельный предмет у доски, размер человеческий.
[node name="TeacherDesk" type="Area3D" parent="Look"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0.55, 0.45, -8.1)
script = ExtResource("6_look")
title = "Учительский стол"
detail = "Пустой, если не считать журнала и стакана с мелом. Стоит боком к классу — так видно и доску, и ряды."
reach = 2.0

[node name="Shape" type="CollisionShape3D" parent="Look/TeacherDesk"]
shape = SubResource("Box_desk")

[node name="HUD" type="CanvasLayer" parent="."]

