; Лаунчер: с чего начинается проект. Главная сцена (см. project.godot), поэтому
; запуск движка без аргументов открывает именно её.
;
; Здесь только рамка - фон, заголовок, сетка и подсказка внизу. Карточки сцен
; собирает scripts/launcher/launcher.gd, а подписи к ним лежат в scenes/games.json.

[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/launcher/launcher.gd" id="1_launcher"]

[sub_resource type="StyleBoxFlat" id="BgStyle"]
bg_color = Color(0.098, 0.106, 0.122, 1)

[node name="Launcher" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_launcher")

[node name="BG" type="Panel" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("BgStyle")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 22
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 18

[node name="Column" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.839, 0.851, 0.875, 1)
theme_override_font_sizes/font_size = 30
text = "photo3d"

[node name="Subtitle" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.596, 0.627, 0.675, 1)
theme_override_font_sizes/font_size = 14
text = "сцены и игры проекта"

[node name="Gap" type="Control" parent="Margin/Column"]
custom_minimum_size = Vector2(0, 16)
layout_mode = 2

; Сетка внутри прокрутки: сцен станет больше, чем помещается в окно, и
; отвалиться должен нижний ряд, а не список целиком.
[node name="Scroll" type="ScrollContainer" parent="Margin/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Grid" type="GridContainer" parent="Margin/Column/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 14
columns = 3

[node name="Hint" type="Label" parent="Margin/Column"]
layout_mode = 2
theme_override_colors/font_color = Color(0.424, 0.451, 0.494, 1)
theme_override_font_sizes/font_size = 13
text = "стрелки — выбор · Enter или щелчок — запустить · Esc — выход"
